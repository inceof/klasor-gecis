# Default deny: publish only the reviewed files and source types below.
# Add new public directories deliberately after reviewing their contents.
*
!/.gitignore
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/licenses/
!/licenses/LICENSE-dotnet.txt
!/licenses/NOTICES-dotnet-runtime.txt
!/licenses/NOTICES-dotnet-winforms.txt
!/licenses/NOTICES-dotnet-wpf.txt
!/README.md
!/build.ps1
!/global.json
!/.github/
!/.github/workflows/
!/.github/workflows/build.yml
!/src/
!/src/KlasorGecis/
!/src/KlasorGecis/*.cs
!/src/KlasorGecis/KlasorGecis.csproj
!/src/KlasorGecis/app.manifest
!/src/KlasorGecis/app.ico
!/src/KlasorGecis/Translations.json
!/tests/
!/tests/ChecksumTests.ps1
!/tests/KlasorGecis.Tests/
!/tests/KlasorGecis.Tests/*.cs
!/tests/KlasorGecis.Tests/KlasorGecis.Tests.csproj
!/installer/
!/installer/KlasorGecis.iss
!/installer/Languages/
!/installer/Languages/*.isl
!/installer/Languages/*.islu
!/installer/Languages/README.md
!/installer/Languages/LICENSE-InnoSetup.txt
!/docs/
!/docs/images/
!/docs/images/settings.png

# Generated outputs and credentials remain excluded even in source directories.
**/bin/
**/obj/
**/.vs/
**/.idea/
**/TestResults/
**/*.user
**/*.suo
**/*.log
**/.env
**/.env.*
**/*.pfx
**/*.p12
**/*.key
